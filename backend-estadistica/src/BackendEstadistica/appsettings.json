{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=DBEstadistica;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Key": "TuClaveSecretaParaJWTQueDebeSerAlMenos16BytesLarga1234", // Reemplaza con una clave secreta segura
    "Issuer": "TuIssuer", // El emisor del token
    "Audience": "TuAudience", // La audiencia del token
    "ExpireMinutes": 60 // Tiempo de expiración del token en minutos
  },
  "AllowedHosts": "*",
  "DataGenerator": {
    "FrecuenciaMinutos": 1440,
    "VolumenClientes": 1,
    "VolumenTransacciones": 15,
    "VolumenConversiones": 7,
    "VolumenOutliers": 1,
    "VolumenDivisas": 1
  }
}
